{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ScottyVenable/fermata/bounty-board/schemas/claim.schema.json",
  "title": "Fermata Bounty Claim",
  "description": "The YAML front matter of a claims/<date>-<handle>.md file, parsed to JSON by the tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bounty", "handle", "kind", "claimed_at", "status"],
  "properties": {
    "bounty": { "type": "string", "pattern": "^FB-[0-9]{4}$" },
    "handle": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["human", "bot"] },
    "operator": { "type": "string", "description": "Required when kind is bot." },
    "claimed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "delivered", "dropped", "expired"] },
    "pr": { "oneOf": [{ "type": "null" }, { "type": "integer" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "bot" } }, "required": ["kind"] },
      "then": { "required": ["operator"] }
    }
  ]
}
