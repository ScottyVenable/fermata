{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ScottyVenable/fermata/bounty-board/schemas/profile.schema.json",
  "title": "Fermata Contributor Profile",
  "description": "DERIVED from the ledger by `npm run rep -- rebuild`. Do not hand-edit reputation/profiles/<handle>.json; put editable fields in reputation/profiles/_overrides/<handle>.json instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handle", "kind", "rep_lifetime", "rep_season", "tier", "first_seen", "last_active", "counts"],
  "properties": {
    "handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\[bot\\])?$" },
    "kind": { "enum": ["human", "bot"] },
    "display_name": { "type": "string", "maxLength": 80 },
    "pronouns": { "type": "string", "maxLength": 40 },
    "bio": { "type": "string", "maxLength": 280 },
    "avatar_url": { "type": "string", "format": "uri" },
    "links": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" } },
    "operator": { "type": "string", "description": "For bots: the accountable human's handle." },
    "rep_lifetime": { "type": "integer" },
    "rep_season": { "type": "integer" },
    "season": { "type": "string", "pattern": "^[0-9]{4}-Q[1-4]$" },
    "tier": { "enum": ["rest", "note", "measure", "phrase", "movement", "fermata", "coda"] },
    "first_seen": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "last_active": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "properties": {
        "bounties_completed": { "type": "integer", "minimum": 0 },
        "bounties_authored": { "type": "integer", "minimum": 0 },
        "reviews": { "type": "integer", "minimum": 0 },
        "projects_published": { "type": "integer", "minimum": 0 },
        "external_merged": { "type": "integer", "minimum": 0 }
      }
    },
    "tracks": { "type": "object", "additionalProperties": { "type": "integer" } },
    "badges": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "stewardship": { "type": "array", "items": { "type": "object" } },
    "recent": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "event": { "type": "string" },
          "ref": { "type": "string" },
          "points": { "type": "integer" }
        }
      }
    }
  }
}
